# identity/git/config -- main git config; symlinked to ~/.config/git/config.
#
# Identity selection model:
#   Workstation identities are loaded via [includeIf gitdir/i:] blocks below
#   that match a project directory prefix. Server identities are loaded via
#   the unconditional [include] path = server-include.config block; that file
#   is materialized by `task identity:server-include` when
#   features.server-include = true, and is absent (silent no-op) on
#   workstations (silent no-op pattern).
#
# Adding a new workstation identity: add a matching [includeIf
# "gitdir/i:~/git/<name>/"] block below (mirrors the personal/work pattern).
# One overlay may back several directories (personal covers ~/git/personal/
# and the katoptra organization at ~/git/katoptra/).
#
# Schema reference: docs/MANIFEST.md "Adding a new identity".
# Callers: taskfiles/identity.yml via _:safe-link to ~/.config/git/config

[user]
    name = Josh Vaughen

[includeIf "gitdir/i:~/git/personal/"]
    path = identities/personal

[includeIf "gitdir/i:~/git/katoptra/"]
    path = identities/personal

[includeIf "gitdir/i:~/git/work/"]
    path = identities/work

[include]
    path = server-include.config

[core]
    editor = code
    excludesfile = ignore
    pager = delta

[init]
    defaultBranch = main

[fetch]
    prune = true  # Auto-prune deleted remote branches

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    syntax-theme = Monokai Extended

[status]
    showUntrackedFiles = all
    submoduleSummary = true

[alias]
    # list all git aliases
    aliases = !git config -l | grep alias | cut -c 7- | highlight --style=duotone-dark-sky --syntax=bash --out-format=xterm256

    # useful aliases
    tags = tag -l
    branches = branch --all
    remotes = remote --verbose
    undo = reset --soft HEAD~1

    # delete local branches whose PR GitHub merged; skips anything unverified
    tidy = "!f() { \
      command -v gh >/dev/null || { echo 'tidy: gh not installed'; return 1; }; \
      git fetch --prune --quiet || echo 'tidy: fetch failed, using cached state'; \
      git for-each-ref --format='%(refname:short) %(upstream:track) %(worktreepath)' refs/heads | { \
        deleted=0; skipped=0; \
        while read -r branch track worktree; do \
          [ \"$track\" = '[gone]' ] || continue; \
          if [ -n \"$worktree\" ]; then \
            printf '  skipped  %-34s checked out at %s\\n' \"$branch\" \"$worktree\"; \
            skipped=$((skipped+1)); continue; \
          fi; \
          pr=$(gh pr list --head \"$branch\" --state merged --json number,headRefOid \
                 --jq '.[] | [.number, .headRefOid] | join(\" \")' 2>/dev/null | tail -1); \
          if [ -z \"$pr\" ]; then \
            printf '  skipped  %-34s no merged PR found\\n' \"$branch\"; \
            skipped=$((skipped+1)); continue; \
          fi; \
          num=${pr%% *}; head=${pr##* }; \
          if [ \"$head\" != \"$(git rev-parse \"$branch\")\" ]; then \
            ahead=$(git rev-list --count \"$head..$branch\" 2>/dev/null) || ahead=0; \
            printf '  skipped  %-34s %s ahead of merged PR #%s\\n' \"$branch\" \"$ahead\" \"$num\"; \
            skipped=$((skipped+1)); continue; \
          fi; \
          git branch -D \"$branch\" >/dev/null && { \
            printf '  deleted  %-34s PR #%s\\n' \"$branch\" \"$num\"; deleted=$((deleted+1)); }; \
        done; \
        echo \"$deleted deleted, $skipped skipped\"; \
      }; \
    }; f"

    # lookups
    whois = "!sh -c 'git log --regexp-ignore-case -1 --pretty=\"format:%an <%ae>\n\" --author=\"$1\"' -"
    whatis = show --no-patch --pretty='tformat:%h (%s, %ad)' --date=short

    # Find commits by source code
    fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"

    # Find commits by commit message
    fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

    # List contributors with number of commits.
    contributors = shortlog --summary --numbered

    # Show the user email for the current repository.
    whoami = config user.email

    # useful displays
    hist = log --graph --abbrev-commit --decorate --all --format=format:"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)"
    latest = for-each-ref --sort=committerdate refs/heads/ --format='%(committerdate:short) %(refname:short)'
    quicklog = log --oneline --decorate -20 --pretty=format:'%C(yellow)%h%C(reset)%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
