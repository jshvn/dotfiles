# identity/ssh/config -- main SSH config; linked to ~/.ssh/config.
#
# Identity selection model:
#   The Include line below points at ~/.ssh/identities/active, a link to one of
#   the overlay files under identity/ssh/identities/, made by the switch from
#   dotfiles.identity (modules/identity.nix).
#
#   Identity resolves at switch time, so the SSH config is static and auditable.
#
# Side effects: none (static config; no runtime eval).

Host *
    SetEnv TERM=xterm-256color

Include ~/.ssh/identities/active
