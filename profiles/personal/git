# profiles/personal/git -- the personal profile's git overlay.
#
# Linked to ~/.config/git/profile and included by apps/git/config for every
# repository under ~/git/. apps/git/config holds the name and the signing
# setup; this file holds the identity and turns signing on.
# Sets: [user] email; [github] user; [commit] gpgsign; [tag] gpgSign.

[user]
    email = josh@vaughen.net

[github]
    user = jshvn

[commit]
    gpgsign = true

[tag]
    gpgSign = true
