# apps/git/config -- main git config; linked to ~/.config/git/config by
# apps/git/default.nix.
#
# The profile's overlay (profiles/<name>/git: the email, and signing on) is
# linked to ~/.config/git/profile and included for every repository under
# ~/git/. The include is an includeIf, not a plain include, because the
# git-identity hook in jshvn/ai reads the expected commit email from includeIf
# blocks. Signing stays in the overlay so a repository elsewhere (a test
# sandbox under $TMPDIR) never asks 1Password to sign.
#
# The signing key is the profile's key.pub, linked to ~/.ssh/profile.pub;
# op-ssh-sign asks the 1Password agent to sign with it. allowed_signers, which
# apps/git/default.nix writes from the same key.pub, is what local
# verification (git verify-tag, git log --show-signature) trusts.

[user]
    name = Josh Vaughen
    signingkey = ~/.ssh/profile.pub

[includeIf "gitdir/i:~/git/"]
    path = profile

[core]
    pager = delta

[init]
    defaultBranch = main

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = ~/.config/git/allowed_signers

[credential]
    # Keep HTTPS auth out of the macOS keychain. Homebrew and Apple both ship
    # git with a system-level "helper = osxkeychain"; the empty value below
    # resets the helper list so that default is ignored. Pushes go over SSH
    # instead (below), which the 1Password agent handles.
    helper =

[url "git@github.com:"]
    # Pushes to GitHub go over SSH; fetches stay on HTTPS, which needs no
    # credentials for public repositories and never waits on 1Password.
    pushInsteadOf = https://github.com/

[fetch]
    prune = true  # Auto-prune deleted remote branches

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    syntax-theme = Monokai Extended

[status]
    showUntrackedFiles = all
    submoduleSummary = true

[alias]
    # An alias here is one line. A longer one is a script in apps/git/functions/,
    # linked to ~/.config/git/functions/, and its line here runs it with zsh, so
    # `git aliases` still lists every alias.

    # list all git aliases
    aliases = !git config -l | grep alias | cut -c 7- | highlight --syntax=bash

    # useful aliases
    tags = tag -l
    branches = branch --all
    remotes = remote --verbose
    undo = reset --soft HEAD~1

    # delete local branches whose PR GitHub merged; skips anything unverified
    tidy = !zsh ~/.config/git/functions/tidy.zsh

    # clone every repo of a GitHub user or org here; skips those already here
    cloneall = !zsh ~/.config/git/functions/cloneall.zsh

    # lookups
    whois = "!sh -c 'git log --regexp-ignore-case -1 --pretty=\"format:%an <%ae>\n\" --author=\"$1\"' -"
    whatis = show --no-patch --pretty='tformat:%h (%s, %ad)' --date=short

    # Find commits by source code
    fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"

    # Find commits by commit message
    fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

    # List contributors with number of commits.
    contributors = shortlog --summary --numbered

    # Show the user email for the current repository.
    whoami = config user.email

    # useful displays
    hist = log --graph --abbrev-commit --decorate --all --format=format:"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)"
    latest = for-each-ref --sort=committerdate refs/heads/ --format='%(committerdate:short) %(refname:short)'
    quicklog = log --oneline --decorate -20 --pretty=format:'%C(yellow)%h%C(reset)%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
