{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  // motd.zsh pipes this through sed, which fastfetch would take as a cue to drop color.
  // Keys and values are the brand's --text-muted and --text-body, unbolded.
  "display": {
    "pipe": false,
    "brightColor": false,
    "separator": " › ",
    "color": {
      "keys": "38;2;154;167;180",
      "output": "38;2;198;208;218"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    // {
    //   "type": "separator",
    //   "string": " "
    // },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk"
    },
    // {
    //   "type": "separator",
    //   "string": " "
    // },
    {
      "type": "localip",
      "key": "Local IP"
    },
    {
      "type": "battery",
      "key": "Battery"
    }
  ]
}
